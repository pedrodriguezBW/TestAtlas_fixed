# ---------------------------------------------------------------------------
# Test Atlas standalone - example configuration (placeholder values only).
# Copy to .env and adapt. Never commit .env.
#
# Backend: Spring Boot reads ./.env or ../.env automatically when started from
#          backend/ (real environment variables take precedence).
# Frontend: load the file into the shell before npm commands (see README).
# ---------------------------------------------------------------------------

# --- Backend (Spring Boot, Java 25) ----------------------------------------
# HTTP port and bind address of the API.
SERVER_PORT=17000
SERVER_ADDRESS=127.0.0.1

# Project repository where Test Atlas creates the test folders and saves files.
# Production value (Windows share): //vigvsfil1.global.borgwarner.net/vigproductengineering/Documentacion_I+D/R&T/9. CL
# For local development use an empty local folder, e.g. C:/Temp/TestAtlasRepository or /tmp/test-atlas-repository
TESTATLAS_REPOSITORY_ROOT=/path/to/local/test-atlas-repository

# Temporary folder for uploads before the save (optional; default <java.io.tmpdir>/test-atlas-staging).
# TESTATLAS_STAGING_ROOT=/path/to/test-atlas-staging

# Browser origins allowed to call the API directly (comma-separated).
# Only needed when the static frontend calls the backend cross-origin (VITE_BACKEND_URL).
TESTATLAS_FRONTEND_ORIGINS=http://localhost:18000,http://127.0.0.1:18000

# --- Frontend (Vite / React) ------------------------------------------------
# Backend origin used by the Vite dev proxy (npm run dev) and by the optional
# same-origin Node server (npm start).
BACKEND_URL=http://127.0.0.1:17000

# Build-time backend URL for static hosting. Leave EMPTY for local development
# and for the Node proxy server: requests stay relative (/api/...).
VITE_BACKEND_URL=

# Optional same-origin production server (npm start), after npm run build.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=18000
SITE_DIR=dist
API_PROXY_TIMEOUT_MS=1800000
